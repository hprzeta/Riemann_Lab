{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y", "@modelcontextprotocol/server-filesystem",
        "/home/riemann/projet_zeta",
        "/mnt/data",
        "/mnt/vault_rag"
      ]
    },
    /* OmniRoute : accès à des modèles distants (DeepSeek, NVIDIA Nemotron, etc.) via
       omniroute_route_request. Le "command" DOIT pointer sur le binaire Node 22 nvm explicite —
       jamais "node" du PATH système (v18 incompatible, engines.node >=22.22.2 requis), sinon
       CONNECTION_CLOSED immédiat. Remplacer la version nvm ci-dessous par la vôtre
       (`nvm ls` / `which node`). Le backend HTTP OmniRoute (port 20128) doit en plus tourner en
       service séparé (`systemctl --user status omniroute`) — voir riemann-agent-bridge §1bis. */
    "omniroute": {
      "command": "/home/riemann/.nvm/versions/node/v22.23.3/bin/node",
      "args": [
        "/home/riemann/.nvm/versions/node/v22.23.3/lib/node_modules/omniroute/bin/omniroute.mjs",
        "--mcp"
      ]
    }
    /* "arxiv": { "à choisir et tester séparément — voir §2.2 synthese_skills_zeta.md" } */
  }
}
